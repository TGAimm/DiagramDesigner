{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Generated with `sdv new`; never edited"
    },
    "parent": {
      "description": "Id of the parent entity; omitted for root modules (systems) and models",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "ownedBy": {
      "description": "Models only: id of the one module owning it",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "storedIn": {
      "description": "Models only: id of the module storing its data (e.g. a database module)",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "models": {
      "description": "Ids of models used here but owned elsewhere; drawn inside as references",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "description": "Kebab-case identifier"
      }
    },
    "fields": {
      "description": "Models only",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Unique across the whole model, like entity ids; generate with `sdv id`"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "description": "Primitive type; give either type or model",
            "type": "string"
          },
          "model": {
            "description": "Id of a model this field holds (composition)",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "many": {
            "description": "Holds a list of type or model",
            "type": "boolean"
          },
          "pk": {
            "description": "Part of the primary key",
            "type": "boolean"
          },
          "pi": {
            "description": "Part of the primary index",
            "type": "boolean"
          },
          "required": {
            "description": "Must be given a value on create; default false",
            "type": "boolean"
          },
          "nullable": {
            "description": "May hold null; default false",
            "type": "boolean"
          },
          "constraints": {
            "description": "Free-text rules such as unique, positive, max 200",
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "ref": {
            "description": "Id of the model or field this field points at (foreign key)",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "from": {
            "description": "Ids of the fields this value comes from; omit for a source field",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "description": "Kebab-case identifier"
            }
          },
          "derived": {
            "description": "How the value is computed or changed from its from fields",
            "type": [
              "string",
              "number"
            ]
          },
          "stored": {
            "description": "false: exists in the class only, never stored (e.g. computed); default true",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "description": "Model field: a table column or an object property"
      }
    },
    "indexes": {
      "description": "Models only",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Lets a scenario change or drop the index; generate with `sdv id`",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "fields": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "description": "Kebab-case identifier"
            },
            "description": "Field ids, in index order"
          },
          "unique": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "fields"
        ],
        "additionalProperties": false,
        "description": "Secondary index over model fields"
      }
    },
    "method": {
      "description": "Apis only: HTTP method; required",
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
      ]
    },
    "path": {
      "description": "Apis only: route, e.g. /orders/{id}; required",
      "type": "string"
    },
    "auth": {
      "description": "Apis only: how callers authenticate, e.g. bearer",
      "type": "string"
    },
    "params": {
      "description": "Apis only: path, query and header params",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Lets a scenario change or drop the param; generate with `sdv id`",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "in": {
            "type": "string",
            "enum": [
              "path",
              "query",
              "header"
            ]
          },
          "type": {
            "type": "string"
          },
          "required": {
            "description": "Path params are always required",
            "type": "boolean"
          },
          "description": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "required": [
          "name",
          "in",
          "type"
        ],
        "additionalProperties": false,
        "description": "Endpoint parameter, outside the body"
      }
    },
    "request": {
      "description": "Apis only: what it takes in the body",
      "type": "object",
      "properties": {
        "model": {
          "description": "Id of the model sent or returned",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "omit": {
          "description": "With model: ids of its fields left out",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Kebab-case identifier"
          }
        },
        "pick": {
          "description": "With model: ids of the only fields sent",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Kebab-case identifier"
          }
        },
        "fields": {
          "description": "A shape of its own, instead of a model",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Unique across the whole design, like model field ids"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "description": "Primitive type; give either type or model",
                "type": "string"
              },
              "model": {
                "description": "Id of a model this field holds",
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "many": {
                "description": "Holds a list of type or model",
                "type": "boolean"
              },
              "required": {
                "type": "boolean"
              },
              "nullable": {
                "type": "boolean"
              },
              "description": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "to": {
                "description": "Request fields: ids of the model fields its value goes into",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "description": "Kebab-case identifier"
                }
              },
              "from": {
                "description": "Response fields: ids of the fields its value comes from",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "description": "Kebab-case identifier"
                }
              },
              "derived": {
                "description": "How the value is changed on the way",
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false,
            "description": "Field of a body shape written on the api"
          }
        },
        "many": {
          "description": "A list of the model or shape",
          "type": "boolean"
        },
        "contentType": {
          "description": "Default application/json",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "responses": {
      "description": "Apis only: what it returns, by status",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "model": {
            "description": "Id of the model sent or returned",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "omit": {
            "description": "With model: ids of its fields left out",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "description": "Kebab-case identifier"
            }
          },
          "pick": {
            "description": "With model: ids of the only fields sent",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "description": "Kebab-case identifier"
            }
          },
          "fields": {
            "description": "A shape of its own, instead of a model",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "description": "Unique across the whole design, like model field ids"
                },
                "name": {
                  "type": "string"
                },
                "type": {
                  "description": "Primitive type; give either type or model",
                  "type": "string"
                },
                "model": {
                  "description": "Id of a model this field holds",
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "many": {
                  "description": "Holds a list of type or model",
                  "type": "boolean"
                },
                "required": {
                  "type": "boolean"
                },
                "nullable": {
                  "type": "boolean"
                },
                "description": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "to": {
                  "description": "Request fields: ids of the model fields its value goes into",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "description": "Kebab-case identifier"
                  }
                },
                "from": {
                  "description": "Response fields: ids of the fields its value comes from",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "description": "Kebab-case identifier"
                  }
                },
                "derived": {
                  "description": "How the value is changed on the way",
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false,
              "description": "Field of a body shape written on the api"
            }
          },
          "many": {
            "description": "A list of the model or shape",
            "type": "boolean"
          },
          "contentType": {
            "description": "Default application/json",
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "description": "One possible response; no model or fields: no body"
      }
    },
    "handles": {
      "description": "Logic units only: ids of the apis whose requests it handles",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "description": "Kebab-case identifier"
      }
    },
    "inputs": {
      "description": "Logic units only, required: what it takes; [] for nothing",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Unique across the whole design, like model field ids"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "description": "Primitive type; give either type or model",
            "type": "string"
          },
          "model": {
            "description": "Id of a model it is",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "many": {
            "description": "A list of type or model",
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "nullable": {
            "type": "boolean"
          },
          "description": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "description": "Input or output of a logic unit"
      }
    },
    "outputs": {
      "description": "Logic units only, required: what it returns; [] for nothing",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Unique across the whole design, like model field ids"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "description": "Primitive type; give either type or model",
            "type": "string"
          },
          "model": {
            "description": "Id of a model it is",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "many": {
            "description": "A list of type or model",
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "nullable": {
            "type": "boolean"
          },
          "description": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "description": "Input or output of a logic unit"
      }
    },
    "fails": {
      "description": "Logic units only: the ways it can fail",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "description": "A way a logic unit can fail"
      }
    },
    "steps": {
      "description": "Logic units only: its sequence; what it reads, writes and calls comes from it",
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "key": {
      "description": "Flags only, required: the name the code asks the flag service for",
      "type": "string"
    },
    "default": {
      "description": "Flags only: the value production runs; default off",
      "type": "string",
      "enum": [
        "on",
        "off"
      ]
    },
    "when": {
      "type": "object",
      "properties": {
        "flag": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Id of the flag"
        },
        "is": {
          "type": "string",
          "enum": [
            "on",
            "off"
          ],
          "description": "The value the flag must have for this to exist"
        }
      },
      "required": [
        "flag",
        "is"
      ],
      "additionalProperties": false,
      "description": "Apis and logic units only: exists only while the flag has this value"
    },
    "external": {
      "description": "Modules and apis: used by consumers the design does not show, so every rename or drop behind it breaks",
      "type": "boolean"
    },
    "name": {
      "description": "Display name; defaults to the file name",
      "type": [
        "string",
        "number"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "url"
        ],
        "additionalProperties": false,
        "description": "Documentation link"
      }
    },
    "meta": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Free-form string metadata"
    }
  },
  "required": [
    "id"
  ],
  "additionalProperties": false,
  "description": "System Design Viewer entity file (<name>.<kind>.yaml)",
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "call": {
          "description": "Id of the logic unit or api it calls",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "read": {
          "description": "Id of the model, or single model field, it reads",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "write": {
          "description": "Id of the model, or single model field, it writes",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "with": {
          "description": "With call or read: what it passes, free text",
          "type": [
            "string",
            "number"
          ]
        },
        "gets": {
          "description": "With call or read: what it gets back, free text",
          "type": [
            "string",
            "number"
          ]
        },
        "if": {
          "description": "A condition; then and else hold the steps of each branch",
          "type": [
            "string",
            "number"
          ]
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "else": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "each": {
          "description": "What it loops over; do holds the steps repeated",
          "type": [
            "string",
            "number"
          ]
        },
        "do": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "return": {
          "description": "Name of the output returned",
          "type": [
            "string",
            "number"
          ]
        },
        "fail": {
          "description": "Name of the fail raised",
          "type": [
            "string",
            "number"
          ]
        },
        "flag": {
          "description": "Id of a flag; on and off hold the steps run in each state",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "off": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "note": {
          "description": "Free text; alone, work the unit does itself",
          "type": [
            "string",
            "number"
          ]
        }
      },
      "additionalProperties": false,
      "description": "One step of a logic unit, in order"
    }
  },
  "title": "System Design Viewer entity file"
}
